FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY pom.xml ./
COPY delivery-core/pom.xml delivery-core/pom.xml
COPY delivery-worker/pom.xml delivery-worker/pom.xml
COPY delivery-server/pom.xml delivery-server/pom.xml
COPY deploy/maven-settings.xml deploy/maven-settings.xml
RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -q -s deploy/maven-settings.xml -DskipTests dependency:go-offline
COPY . .
RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -q -s deploy/maven-settings.xml -DskipTests package

FROM maven:3.9-eclipse-temurin-17
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 -m delivery \
    && mkdir -p /data/work /data/ftp-verify \
    && chown -R 10001:10001 /data
WORKDIR /app
COPY --from=build /workspace/delivery-worker/target/delivery-worker.jar app.jar
COPY nodes/python /app/nodes/python
USER 10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
