FROM docker.1ms.run/library/maven:3.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY . .
RUN mvn -q -s deploy/maven-settings.xml -DskipTests package

FROM docker.1ms.run/library/maven:3.9-eclipse-temurin-17
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 -m delivery \
    && mkdir -p /data/work /data/ftp-verify \
    && chown -R 10001:10001 /data
WORKDIR /app
COPY --from=build /workspace/delivery-worker/target/delivery-worker.jar app.jar
COPY nodes/python /app/nodes/python
USER 10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
