COMPOSE_PROJECT_NAME=archive_delivery_production
ARCHIVE_DB_URL=jdbc:postgresql://postgres:5432/archive_delivery
ARCHIVE_DB_USER=archive
ARCHIVE_DB_PASSWORD=replace-production-database-password
ARCHIVE_UPGRADE_AUTHORIZED=
ARCHIVE_WORKER_GROUP=group1
ARCHIVE_MAX_RUNNING_TASKS=3
ARCHIVE_PG_BIND_ADDRESS=127.0.0.1

POWERJOB_ENABLED=true
POWERJOB_APP_NAME=archive-delivery
POWERJOB_SERVER_ADDRESS=powerjob-server:7700
POWERJOB_BIND_ADDRESS=127.0.0.1
POWERJOB_JVMOPTIONS=
POWERJOB_MYSQL_ROOT_PASSWORD=replace-powerjob-mysql-password
POWERJOB_USERNAME=replace-powerjob-app-user
POWERJOB_PASSWORD=replace-powerjob-app-password
POWERJOB_ADMIN_USER=ADMIN
POWERJOB_ADMIN_INITIAL_PASSWORD=powerjob_admin
POWERJOB_ADMIN_PASSWORD=replace-powerjob-admin-password

OSS_SOURCE_ACCESS_KEY_ID=replace-source-access-key
OSS_SOURCE_ACCESS_KEY_SECRET=replace-source-secret
TARGET_OSS_ACCESS_KEY_ID=replace-target-access-key
TARGET_OSS_ACCESS_KEY_SECRET=replace-target-secret

PROD_ENTITY_COUNT=1
PROD_ENTITY_1_VENDOR_CODE=alibaba
PROD_ENTITY_1_ENTITY_CODE=jun
PROD_ENTITY_1_NAME="生产交付实体 jun"
PROD_ENTITY_1_ACCOUNT=june
PROD_ENTITY_1_HOST=ftp-june
ENTITY_1_WORKER_GROUP=group1
PROD_FTP_ENTITY_1_PORT=21
PROD_FTP_ENTITY_1_ROOT_PATH=/
PROD_FTP_ENTITY_1_PASSWORD=replace-june-ftp-password
PROD_JUNE_HOST_ROOT=/srv/maas-sftp/maasData/archive/june

PROD_PIPELINE_OBSERVATION_SECONDS=1800
