ARCHIVE_DB_URL=jdbc:postgresql://postgres:5432/archive_delivery
ARCHIVE_DB_USER=archive
ARCHIVE_DB_PASSWORD=replace-with-local-password
# 仅在已明确放弃旧本地数据的 V14 升级命令中设置 2026-11-07；迁移完成后可移除。
ARCHIVE_UPGRADE_AUTHORIZED=
# 执行组对应一台服务器的本地工作目录；同组 Worker 必须部署在同一台服务器。
ARCHIVE_WORKER_GROUP=group1
# 每个执行组允许同时运行的任务数，不是单 Worker 或全集群统一计数。
ARCHIVE_MAX_RUNNING_TASKS=3
# 本地默认回环；公网主子连接使用 0.0.0.0，并由安全组限制对方公网 IP。
ARCHIVE_PG_BIND_ADDRESS=127.0.0.1
ENTITY_1_WORKER_GROUP=group1
ENTITY_2_WORKER_GROUP=group1
ENTITY_3_WORKER_GROUP=group1

POWERJOB_ENABLED=true
POWERJOB_APP_NAME=archive-delivery
POWERJOB_SERVER_ADDRESS=powerjob-server:7700
POWERJOB_BIND_ADDRESS=127.0.0.1
# 公网部署示例：-Dpowerjob.network.external.address=replace-with-primary-public-ip -Dpowerjob.network.external.port=7700
POWERJOB_JVMOPTIONS=
POWERJOB_USERNAME=replace-me
POWERJOB_PASSWORD=replace-me
POWERJOB_ADMIN_USER=ADMIN
POWERJOB_ADMIN_PASSWORD=replace-me

# 仅用于本地三个隔离 FTP 验证账户；真实环境通过受控 Pipeline 配置注入。
LOCAL_FTP_ENTITY_1_PASSWORD=replace-local-entity1-password
LOCAL_FTP_ENTITY_2_PASSWORD=replace-local-entity2-password
LOCAL_FTP_ENTITY_3_PASSWORD=replace-local-entity3-password

# 生产配置使用独立 env.production.example 和 docker-compose.production.yml，不复用本地测试变量。
