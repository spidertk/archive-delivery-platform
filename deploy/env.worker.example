# 纯 Worker 服务器通过公网连接主服务，不携带 V14 清库授权。
ARCHIVE_DB_URL=jdbc:postgresql://replace-with-primary-host:5432/archive_delivery
ARCHIVE_DB_USER=replace-with-database-user
ARCHIVE_DB_PASSWORD=replace-with-production-password
ARCHIVE_WORKER_GROUP=group2
ARCHIVE_MAX_RUNNING_TASKS=3

POWERJOB_ENABLED=true
POWERJOB_APP_NAME=archive-delivery
POWERJOB_SERVER_ADDRESS=replace-with-primary-host:7700
# PowerJob 向主服务器注册的公网回调地址；每个容器使用各自端口。
POWERJOB_EXTERNAL_ADDRESS=replace-with-worker-public-ip
