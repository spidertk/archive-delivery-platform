FROM node:24-bookworm-slim AS web
WORKDIR /workspace
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web .
RUN npm run build

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY . .
COPY --from=web /workspace/dist ./web/dist
RUN mvn -q -DskipTests package

FROM eclipse-temurin:17-jre-jammy
RUN useradd -r -u 10001 -m delivery
WORKDIR /app
COPY --from=build /workspace/delivery-server/target/delivery-server.jar app.jar
USER 10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
